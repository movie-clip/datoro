<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  
  <!-- Homepage: Dynamic SPA that serves stock data via query parameters -->
  <!-- All ticker URLs (/?ticker=AAPL, etc.) canonicalize to this base URL -->
  <!-- This approach consolidates page authority and avoids duplicate content issues -->
  <url>
    <loc>https://datoro.onrender.com/</loc>
    <lastmod>2025-11-08</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  
  <!-- Note: Individual ticker pages are not listed here because:
       1. They use query parameters (/?ticker=AAPL) which are dynamic SPA routes
       2. All ticker URLs have canonical tags pointing to the base URL
       3. This prevents duplicate content issues in Google Search Console
       4. Google discovers ticker content through internal search and user interactions
       5. Dynamic meta tags (title, description, OG tags) differentiate each ticker view
  -->
  
</urlset>