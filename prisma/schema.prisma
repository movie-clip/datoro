// Finance View - Database Schema
// User tracking, search analytics, popular tickers, API usage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================
// User Management
// ============================================

model User {
  id        String   @id @default(uuid())
  
  // Authentication fields
  email     String?  @unique
  password  String?  // bcrypt hash (null for OAuth-only users)
  emailVerified Boolean @default(false) @map("email_verified")
  
  // OAuth fields
  googleId  String?  @unique @map("google_id")
  avatarUrl String?  @map("avatar_url")
  
  // User profile
  name      String?
  
  // Subscription fields
  subscriptionTier String @default("free") @map("subscription_tier") // free, premium, enterprise
  subscriptionStatus String @default("active") @map("subscription_status") // active, canceled, expired
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  
  // Legacy tracking fields (for backwards compatibility)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  searches    Search[]
  apiRequests ApiRequest[]
  sessions    Session[]
  watchlistItems WatchlistItem[]

  @@index([email])
  @@index([googleId])
  @@index([subscriptionTier])
  @@index([subscriptionStatus])
  @@map("users")
}

// ============================================
// Session Management (JWT alternative for security)
// ============================================

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique // hashed session token
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================
// Search Tracking
// ============================================

model Search {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ticker    String
  query     String?
  source    String   @default("direct") // direct, search, autocomplete
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticker])
  @@index([userId])
  @@index([createdAt])
  // Composite indexes for common query patterns (performance optimization)
  @@index([ticker, createdAt(sort: Desc)]) // Popular tickers over time
  @@index([userId, createdAt(sort: Desc)]) // User search history
  @@index([userId, ticker, createdAt(sort: Desc)]) // User-specific ticker history
  @@index([source, createdAt(sort: Desc)]) // Search source analytics
  @@map("searches")
}

// ============================================
// Watchlist
// ============================================

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ticker    String
  addedAt   DateTime @default(now()) @map("added_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, ticker])
  @@index([userId, addedAt(sort: Desc)])
  @@index([ticker])
  @@map("watchlist_items")
}

// ============================================
// Popular Tickers (Aggregated)
// ============================================

model PopularTicker {
  id           String   @id @default(uuid())
  ticker       String   @unique
  companyName  String?  @map("company_name")
  searchCount  Int      @default(0) @map("search_count")
  lastSearched DateTime @default(now()) @map("last_searched")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([searchCount(sort: Desc)])
  @@index([lastSearched(sort: Desc)])
  @@map("popular_tickers")
}

// ============================================
// API Request Analytics
// ============================================

model ApiRequest {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  endpoint     String
  method       String   @default("GET")
  statusCode   Int      @map("status_code")
  responseTime Int      @map("response_time") // milliseconds
  cached       Boolean  @default(false)
  errorCode    String?  @map("error_code")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([endpoint])
  @@index([statusCode])
  @@index([createdAt])
  @@index([userId])
  // Composite indexes for analytics queries (performance optimization)
  @@index([endpoint, createdAt(sort: Desc)]) // Endpoint statistics
  @@index([statusCode, createdAt(sort: Desc)]) // Error rate calculations
  @@index([userId, createdAt(sort: Desc)]) // User activity tracking
  @@index([endpoint, statusCode, createdAt(sort: Desc)]) // Endpoint error analysis
  @@index([cached, createdAt(sort: Desc)]) // Cache effectiveness tracking
  @@index([userId, endpoint, createdAt(sort: Desc)]) // User request patterns per endpoint
  @@map("api_requests")
}

// ============================================
// Daily Analytics (Aggregated)
// ============================================

model DailyAnalytics {
  id              String   @id @default(uuid())
  date            DateTime @unique @db.Date
  totalRequests   Int      @default(0) @map("total_requests")
  uniqueUsers     Int      @default(0) @map("unique_users")
  cacheHitRate    Float    @default(0) @map("cache_hit_rate")
  avgResponseTime Int      @default(0) @map("avg_response_time")
  errorRate       Float    @default(0) @map("error_rate")
  topTicker       String?  @map("top_ticker")
  topEndpoint     String?  @map("top_endpoint")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@map("daily_analytics")
}

// ============================================
// Error Log (for debugging)
// ============================================

model ErrorLog {
  id         String    @id @default(uuid())
  errorCode  String    @map("error_code")
  message    String
  endpoint   String?
  ticker     String?
  stackTrace String?   @map("stack_trace") @db.Text
  userId     String?   @map("user_id")
  ipAddress  String?   @map("ip_address")
  count      Int       @default(1) // For grouping same errors
  firstSeen  DateTime  @default(now()) @map("first_seen")
  lastSeen   DateTime  @default(now()) @map("last_seen")
  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")

  @@index([errorCode])
  @@index([endpoint])
  @@index([ticker])
  @@index([resolved])
  @@index([firstSeen(sort: Desc)])
  // Composite indexes for error analysis
  @@index([errorCode, resolved, lastSeen(sort: Desc)]) // Active errors by type
  @@index([endpoint, errorCode, lastSeen(sort: Desc)]) // Endpoint-specific errors
  @@index([ticker, errorCode, lastSeen(sort: Desc)]) // Ticker-specific errors
  @@map("error_logs")
}
