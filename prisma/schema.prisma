// Finance View - Database Schema
// User tracking, search analytics, popular tickers, API usage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================
// User Management
// ============================================

model User {
  id        String   @id @default(uuid())
  
  // Authentication fields
  email     String?  @unique
  password  String?  // bcrypt hash (null for OAuth-only users)
  emailVerified Boolean @default(false) @map("email_verified")
  verificationToken String? @map("verification_token") // Email verification token
  verificationTokenExpiry DateTime? @map("verification_token_expiry") // Token expiration
  emailVerificationSentAt DateTime? @map("email_verification_sent_at") // Rate limiting
  
  // OAuth fields
  googleId  String?  @unique @map("google_id")
  avatarUrl String?  @map("avatar_url")
  
  // User profile
  name      String?
  
  // Legacy tracking fields (for backwards compatibility)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  searches    Search[]
  apiRequests ApiRequest[]
  sessions    Session[]
  watchlists  Watchlist[]
  watchlistItems WatchlistItem[] // Temporary during migration, will be removed
  
  // Subscription relations
  subscription      Subscription?
  paymentHistory    PaymentHistory[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

// ============================================
// Session Management (JWT alternative for security)
// ============================================

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique // hashed session token
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================
// Search Tracking
// ============================================

model Search {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ticker    String
  query     String?
  source    String   @default("direct") // direct, search, autocomplete
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticker])
  @@index([userId])
  @@index([createdAt])
  // Composite indexes for common query patterns (performance optimization)
  @@index([ticker, createdAt(sort: Desc)]) // Popular tickers over time
  @@index([userId, createdAt(sort: Desc)]) // User search history
  @@index([userId, ticker, createdAt(sort: Desc)]) // User-specific ticker history
  @@index([source, createdAt(sort: Desc)]) // Search source analytics
  @@map("searches")
}

// ============================================
// Watchlist Management (Multi-Watchlist Support)
// ============================================

// Watchlist - Container for multiple ticker lists per user
model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   // User-defined name (e.g., "Tech Stocks", "Dividend Growth")
  isDefault Boolean  @default(false) @map("is_default") // One default watchlist per user
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]
  
  // Indexes for performance
  @@index([userId])
  @@index([userId, isDefault]) // Fast lookup for default watchlist
  @@index([userId, createdAt(sort: Desc)]) // User watchlists ordered by creation
  @@map("watchlists")
}

// WatchlistItem - Individual tickers within a watchlist
model WatchlistItem {
  id           String    @id @default(uuid())
  watchlistId  String    @map("watchlist_id")
  userId       String?   @map("user_id") // Temporary during migration, will be removed
  ticker       String
  addedAt      DateTime  @default(now()) @map("added_at")
  displayOrder Int       @default(0) @map("display_order")
  
  watchlist Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade) // Temporary during migration
  
  // Unique constraint: one ticker per watchlist
  @@unique([watchlistId, ticker])
  
  // Indexes for performance
  @@index([watchlistId])
  @@index([watchlistId, displayOrder]) // Fast ordered retrieval
  @@index([watchlistId, addedAt(sort: Desc)]) // Recently added items
  @@index([ticker]) // Lookup by ticker across all watchlists
  
  // Legacy indexes (will be removed after migration)
  @@index([userId, displayOrder])
  @@index([userId, addedAt(sort: Desc)])
  
  @@map("watchlist_items")
}

// ============================================
// Popular Tickers (Aggregated)
// ============================================

model PopularTicker {
  id           String   @id @default(uuid())
  ticker       String   @unique
  companyName  String?  @map("company_name")
  searchCount  Int      @default(0) @map("search_count")
  lastSearched DateTime @default(now()) @map("last_searched")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([searchCount(sort: Desc)])
  @@index([lastSearched(sort: Desc)])
  @@map("popular_tickers")
}

// ============================================
// API Request Analytics
// ============================================

model ApiRequest {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  endpoint     String
  method       String   @default("GET")
  statusCode   Int      @map("status_code")
  responseTime Int      @map("response_time") // milliseconds
  cached       Boolean  @default(false)
  errorCode    String?  @map("error_code")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([endpoint])
  @@index([statusCode])
  @@index([createdAt])
  @@index([userId])
  // Composite indexes for analytics queries (performance optimization)
  @@index([endpoint, createdAt(sort: Desc)]) // Endpoint statistics
  @@index([statusCode, createdAt(sort: Desc)]) // Error rate calculations
  @@index([userId, createdAt(sort: Desc)]) // User activity tracking
  @@index([endpoint, statusCode, createdAt(sort: Desc)]) // Endpoint error analysis
  @@index([cached, createdAt(sort: Desc)]) // Cache effectiveness tracking
  @@index([userId, endpoint, createdAt(sort: Desc)]) // User request patterns per endpoint
  @@map("api_requests")
}

// ============================================
// Daily Analytics (Aggregated)
// ============================================

model DailyAnalytics {
  id              String   @id @default(uuid())
  date            DateTime @unique @db.Date
  totalRequests   Int      @default(0) @map("total_requests")
  uniqueUsers     Int      @default(0) @map("unique_users")
  cacheHitRate    Float    @default(0) @map("cache_hit_rate")
  avgResponseTime Int      @default(0) @map("avg_response_time")
  errorRate       Float    @default(0) @map("error_rate")
  topTicker       String?  @map("top_ticker")
  topEndpoint     String?  @map("top_endpoint")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@map("daily_analytics")
}

// ============================================
// Error Log (for debugging)
// ============================================

model ErrorLog {
  id         String    @id @default(uuid())
  errorCode  String    @map("error_code")
  message    String
  endpoint   String?
  ticker     String?
  stackTrace String?   @map("stack_trace") @db.Text
  userId     String?   @map("user_id")
  ipAddress  String?   @map("ip_address")
  count      Int       @default(1) // For grouping same errors
  firstSeen  DateTime  @default(now()) @map("first_seen")
  lastSeen   DateTime  @default(now()) @map("last_seen")
  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")

  @@index([errorCode])
  @@index([endpoint])
  @@index([ticker])
  @@index([resolved])
  @@index([firstSeen(sort: Desc)])
  // Composite indexes for error analysis
  @@index([errorCode, resolved, lastSeen(sort: Desc)]) // Active errors by type
  @@index([endpoint, errorCode, lastSeen(sort: Desc)]) // Endpoint-specific errors
  @@index([ticker, errorCode, lastSeen(sort: Desc)]) // Ticker-specific errors
  @@map("error_logs")
}

// ============================================
// Subscription Management
// ============================================

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Subscription details
  status                SubscriptionStatus @default(TRIALING)
  
  // Stripe integration (migrated from User model)
  stripeCustomerId      String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?  @unique @map("stripe_subscription_id")
  stripePriceId         String?  @map("stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map("stripe_current_period_end")
  
  // Trial management
  trialStartsAt         DateTime @map("trial_starts_at")
  trialEndsAt           DateTime @map("trial_ends_at")
  isInTrial             Boolean  @default(true) @map("is_in_trial")
  
  // Billing
  currentPeriodStart    DateTime? @map("current_period_start")
  currentPeriodEnd      DateTime? @map("current_period_end")
  cancelAtPeriodEnd     Boolean  @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime? @map("canceled_at")
  
  // Timestamps
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

model PaymentHistory {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Payment details
  amount            Int      // Amount in cents (1900 = $19.00)
  currency          String   @default("usd")
  status            PaymentStatus
  
  // Stripe integration
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  stripeInvoiceId       String? @unique @map("stripe_invoice_id")
  
  // Metadata
  description       String?
  failureReason     String?  @map("failure_reason")
  receiptUrl        String?  @map("receipt_url")
  
  // Timestamps
  createdAt         DateTime @default(now()) @map("created_at")
  paidAt            DateTime? @map("paid_at")
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_history")
}

enum SubscriptionStatus {
  TRIALING          // In 30-day trial
  ACTIVE            // Paid and active
  PAST_DUE          // Payment failed, in grace period
  CANCELED          // User canceled
  INCOMPLETE        // Checkout not completed
  INCOMPLETE_EXPIRED // Checkout expired
  UNPAID            // Payment failed, no grace period left
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
