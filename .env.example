# ==============================================
# Factorly Environment Configuration
# ==============================================
# Copy this file to .env and .env.local and fill in your actual values
# .env      - Database configuration (tracked in git for team)
# .env.local - API keys and secrets (NOT tracked in git - keep private!)

# ==============================================
# DATABASE CONFIGURATION (.env file)
# ==============================================
# PostgreSQL connection URL with automatic connection pooling
# System auto-detects provider (Supabase/Render/Local) and optimizes settings
#
# Supported providers:
#   - Supabase (pooler.supabase.com) - FREE: 60 connections, PAID: 200+ connections  
#   - Render PostgreSQL (render.com) - FREE: 97 connections
#   - Local PostgreSQL (localhost) - Unlimited
#
# For PM2 cluster mode (4 workers), add these parameters:
#   ?connection_limit=14&pool_timeout=10&connect_timeout=5&statement_timeout=10000
#
# Connection limit per worker:
#   - Supabase FREE:  14 (4×14=56, leaves 4 buffer)
#   - Supabase PAID:  45 (4×45=180, leaves 20 buffer)
#   - Render FREE:    22 (4×22=88, leaves 9 buffer)
#
# Example (Supabase):
# DATABASE_URL="postgresql://user:pass@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?connection_limit=14&pool_timeout=10&connect_timeout=5&statement_timeout=10000"

DATABASE_URL="postgresql://user:password@host:5432/database"

# Direct connection for migrations (bypasses connection pooler)
# Only needed for Supabase (use port 6543) or Render with direct access
# Example: postgresql://user:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT="postgresql://user:password@direct-host:6543/database"

# Optional: Override auto-detection (usually not needed)
# DATABASE_PROVIDER="supabase-free"

# ==============================================
# API KEYS & SECRETS (.env.local file)
# ==============================================
# NEVER commit .env.local to git! Add it to .gitignore

# REQUIRED: Financial Modeling Prep API Key
# Get yours at: https://site.financialmodelingprep.com/developer/docs
# Free tier: 250 requests/day
# Used by backend server only (never exposed to frontend)
FMP_API_KEY=your_fmp_api_key_here

# OPTIONAL: Redis Cache (improves performance, recommended for production)
# Leave empty to use memory-only cache (fine for development/testing)
# 
# Options:
#   - Redis Cloud FREE: 25MB, get at https://redis.com/try-free/
#     Format: rediss://default:password@endpoint.upstash.io:6379
#   - Local Redis: redis://localhost:6379
#   - AWS ElastiCache: redis://your-cache.cache.amazonaws.com:6379
#
# If empty, multi-layer memory cache is used (no persistence between restarts)
REDIS_URL=

# OPTIONAL: Sentry Error Tracking
# Sign up at https://sentry.io (FREE: 5K errors/month, 10K transactions/month)
# Create a Node.js project and copy your DSN
# Leave empty to disable error tracking
SENTRY_DSN=

# ==============================================
# SERVER CONFIGURATION
# ==============================================
# Environment: development, staging, or production
NODE_ENV=development

# Server port (default: 7071)
PORT=7071

# CORS Configuration
# Development: Allow requests from local frontend
DEV_ORIGIN=http://localhost:5173

# Production: Comma-separated list of allowed frontend domains
# Example: ALLOWED_ORIGINS=https://factorly.onrender.com,https://www.factorly.com
# ALLOWED_ORIGINS=

# ==============================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================
# Backend API URL for frontend to connect to
# 
# Development (leave empty for auto-proxy):
VITE_API_BASE_URL=

# Production (REQUIRED - set in hosting platform):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

# ==============================================
# QUICK START
# ==============================================
# 1. Copy this file:
#    cp .env.example .env
#    cp .env.example .env.local
#
# 2. Edit .env:
#    - Add your DATABASE_URL
#    - Add DATABASE_URL_DIRECT (if using Supabase)
#
# 3. Edit .env.local:
#    - Add your FMP_API_KEY (REQUIRED)
#    - Add REDIS_URL (optional but recommended)
#    - Add SENTRY_DSN (optional)
#
# 4. Run database migrations:
#    npx prisma migrate deploy
#
# 5. Start development:
#    npm run dev          # Frontend (Vite)
#    npm run pm2:dev      # Backend (PM2 cluster mode)
#
# 6. Open browser:
#    http://localhost:5173
#
# For production deployment, see: DEPLOYMENT_CHECKLIST.md
