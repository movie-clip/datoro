# ==============================================
# Datoro Environment Configuration
# ==============================================
# Copy this file to .env and .env.local and fill in your actual values
# .env      - Database configuration (tracked in git for team)
# .env.local - API keys and secrets (NOT tracked in git - keep private!)

# ==============================================
# DATABASE CONFIGURATION (.env file)
# ==============================================
# PostgreSQL connection URL with automatic connection pooling
# System auto-detects provider (Render/Local) and optimizes settings
#
# Supported providers:
#   - Render PostgreSQL (render.com) - FREE: 97 connections
#   - Local PostgreSQL (localhost) - Unlimited
#
# For PM2 cluster mode (4 workers), add these parameters:
#   ?connection_limit=22&pool_timeout=10&connect_timeout=5&statement_timeout=10000
#
# Connection limit per worker:
#   - Render FREE:    22 (4×22=88, leaves 9 buffer)
#   - Local:          23 (4×23=92, leaves 8 buffer)
#
# Example (Render):
# DATABASE_URL="postgresql://user:pass@host.render.com:5432/database?connection_limit=22&pool_timeout=10&connect_timeout=5&statement_timeout=10000"

DATABASE_URL="postgresql://user:password@host:5432/database"

# Optional: Override auto-detection (usually not needed)
# DATABASE_PROVIDER="render-postgres"  # or "local-postgres"

# ==============================================
# API KEYS & SECRETS (.env.local file)
# ==============================================
# NEVER commit .env.local to git! Add it to .gitignore

# REQUIRED: Financial Modeling Prep API Key
# Get yours at: https://site.financialmodelingprep.com/developer/docs
# Free tier: 250 requests/day
# Used by backend server only (never exposed to frontend)
FMP_API_KEY=your_fmp_api_key_here

# OPTIONAL: Redis Cache (improves performance, recommended for production)
# Leave empty to use memory-only cache (fine for development/testing)
# 
# Options:
#   - Render Redis (FREE: 25MB) - Auto-configured in render.yaml
#   - Local Redis: redis://localhost:6379
#   - Redis Cloud: rediss://default:password@endpoint.redis.cloud:6379
#
# If empty, multi-layer memory cache is used (no persistence between restarts)
REDIS_URL=

# OPTIONAL: Sentry Error Tracking
# Sign up at https://sentry.io (FREE: 5K errors/month, 10K transactions/month)
# Create a Node.js project and copy your DSN
# Leave empty to disable error tracking
SENTRY_DSN=

# ==============================================
# SERVER CONFIGURATION
# ==============================================
# Environment: development, staging, or production
NODE_ENV=development

# Server port (default: 7071)
PORT=7071

# CORS Configuration
# Development: Allow requests from local frontend
DEV_ORIGIN=http://localhost:5173

# Production: Comma-separated list of allowed frontend domains
# Example: ALLOWED_ORIGINS=https://Datoro.onrender.com,https://www.Datoro.com
# ALLOWED_ORIGINS=

# ==============================================
# AUTHENTICATION & SECURITY (.env.local file)
# ==============================================
# REQUIRED for authentication features

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# IMPORTANT: Use different secrets for dev and production!
JWT_SECRET=your_jwt_secret_here

# JWT expiration time (default: 7d)
JWT_EXPIRES_IN=7d

# Google OAuth (optional)
# Get credentials at: https://console.cloud.google.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ==============================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================
# Backend API URL for frontend to connect to
# 
# Development (leave empty for auto-proxy):
VITE_API_BASE_URL=

# Production (REQUIRED - set in hosting platform):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

# ==============================================
# QUICK START
# ==============================================
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Edit .env.local and add:
#    - DATABASE_URL (your PostgreSQL connection)
#    - FMP_API_KEY (REQUIRED - from financialmodelingprep.com)
#    - JWT_SECRET (generate new one)
#    - REDIS_URL (optional but recommended)
#    - SENTRY_DSN (optional)
#
# 3. For Docker development:
#    npm run docker:dev:up
#    # Then use DATABASE_URL=postgresql://Datoro_dev:dev_password_123@localhost:5433/Datoro_dev
#
# 4. Run database migrations:
#    npx prisma generate
#    npx prisma db push
#
# 5. Start development:
#    npm run start:dev    # Both API + Frontend
#    # OR separately:
#    npm run server:dev   # Backend only
#    npm run dev          # Frontend only
#
# 6. Open browser:
#    http://localhost:5173
#
# For production deployment, see: render.yaml

