# FMP API Key - Get yours at https://site.financialmodelingprep.com/developer/docs
# This key is used by the backend server only (never exposed to frontend)
FMP_API_KEY=your_fmp_api_key_here

# Redis Cache Configuration (OPTIONAL)
# Leave empty to use memory-only cache (fine for development)
# For production:
#   - Redis Cloud free tier: redis://default:password@endpoint:port
#   - Local Redis: redis://localhost:6379
#   - AWS ElastiCache: redis://your-cache.cache.amazonaws.com:6379
REDIS_URL=

# Sentry Error Tracking (OPTIONAL)
# Sign up at https://sentry.io (FREE: 5K errors/month, 10K transactions/month)
# Create a Node.js project and copy your DSN
# Leave empty to disable error tracking
SENTRY_DSN=

# Environment (development/staging/production)
NODE_ENV=development

# AI Analysis Configuration
# Choose your AI provider: 'openai' or 'ollama'
VITE_AI_PROVIDER=openai

# OpenAI Configuration (if using VITE_AI_PROVIDER=openai)
# Get your API key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (if using VITE_AI_PROVIDER=ollama)
# Make sure Ollama is running locally
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2

# Server Configuration
PORT=7071

# Development URLs (local development)
DEV_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:7071

# Production URLs (set these for production deployment)
# PROD_ORIGIN=https://your-frontend-domain.com
# PROD_API_BASE_URL=https://your-backend-domain.com
# For multiple allowed origins, comma-separated:
# ALLOWED_ORIGINS=https://domain1.com,https://domain2.com,https://domain3.com

# Database Configuration (Prisma/PostgreSQL)
# Connection pool settings recommended for production:
# - Render.com: connection_limit=5-10 (free tier has 5 connection limit)
# - Supabase Free tier: connection_limit=5
# - Supabase Paid tier: connection_limit=10-20
# - pool_timeout: 10 seconds
# - connect_timeout: 5 seconds
# 
# Render.com provides this automatically via DATABASE_URL environment variable
# Example format: postgresql://user:password@host:5432/dbname?connection_limit=5&pool_timeout=10
DATABASE_URL=your_database_url_here

# For Render.com, you may also need:
# DATABASE_URL_DIRECT=your_direct_database_url_here
