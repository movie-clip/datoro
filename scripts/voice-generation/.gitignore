# Exclude generated audio files
voiceovers/*.mp3

# Exclude voice samples (may contain personal recordings)
voice_samples/*.mp3
voice_samples/*.wav

# Keep directory structure
!voiceovers/.gitkeep
!voice_samples/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment
.env
*.env

# IDE
.vscode/
.idea/
