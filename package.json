{
  "name": "finance-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.mjs",
    "start": "concurrently \"npm run server\" \"npm run dev\" --names \"SERVER,CLIENT\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop finance-view-api",
    "pm2:restart": "pm2 restart finance-view-api",
    "pm2:reload": "pm2 reload finance-view-api",
    "pm2:logs": "pm2 logs finance-view-api",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "@sentry/node": "^10.19.0",
    "@sentry/profiling-node": "^10.19.0",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-slow-down": "^3.0.0",
    "fetch-cookie": "^3.1.0",
    "ioredis": "^5.8.1",
    "joi": "^18.0.1",
    "lru-cache": "^11.2.2",
    "node-fetch": "^3.3.2",
    "tough-cookie": "^6.0.0",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.1",
    "prisma": "^6.17.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
