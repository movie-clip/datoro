{
  "name": "factorly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.mjs",
    "server:dev": "dotenv -e .env.development.local -- node server/server.mjs",
    "start": "concurrently \"npm run server\" \"npm run dev\" --names \"SERVER,CLIENT\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\"",
    "start:dev": "concurrently \"npm run server:dev\" \"npm run dev\" --names \"SERVER,CLIENT\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "pm2:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop factorly-api",
    "pm2:restart": "pm2 restart factorly-api",
    "pm2:reload": "pm2 reload factorly-api",
    "pm2:logs": "pm2 logs factorly-api",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "validate": "npm run lint:check && npm test && npm run build",
    "validate:quick": "npm run lint:check && npm test",
    "lint:check": "eslint . --ext .ts,.js,.vue,.mjs",
    "lint:fix": "eslint . --ext .ts,.js,.vue,.mjs --fix",
    "type-check": "vue-tsc --noEmit",
    "type-check:server": "tsc --project tsconfig.server.json --noEmit",
    "db:monitor": "node scripts/monitor-db-performance.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:push": "npx prisma db push",
    "db:reset": "npx prisma migrate reset",
    "docker:dev:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "ci:local": "act",
    "ci:local:test": "act -j test",
    "ci:local:build": "act -j build",
    "ci:local:dry": "act -n",
    "ci:local:pr": "act pull_request",
    "prepush": "npm run validate:quick"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "@sentry/node": "^10.19.0",
    "@sentry/profiling-node": "^10.19.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "fetch-cookie": "^3.1.0",
    "google-auth-library": "^10.4.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.2.2",
    "node-fetch": "^3.3.2",
    "pinia": "^3.0.3",
    "tough-cookie": "^6.0.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.0",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tsconfig/node18": "^18.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "ioredis-mock": "^8.13.0",
    "nock": "^14.0.10",
    "prisma": "^6.17.1",
    "supertest": "^7.1.4",
    "terser": "^5.44.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.2"
  }
}
