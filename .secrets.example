# Example secrets file for local Act testing
# Copy this to .secrets and fill in your actual values
# NEVER commit .secrets to git!

FMP_API_KEY=your_fmp_api_key_here

# Database URL with optimized connection pooling
# For Render Free Tier (97 max connections, 4 PM2 workers):
# - connection_limit=22 (4 workers × 22 = 88, leaves 9 buffer)
# - pool_timeout=10 (seconds to wait for connection)
# - connect_timeout=5 (seconds for initial connection)
# - statement_timeout=10000 (10s max query time in milliseconds)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public&connection_limit=22&pool_timeout=10&connect_timeout=5&statement_timeout=10000"

REDIS_URL=your_redis_url_here

# Optional: Add other secrets as needed
# SENTRY_DSN=your_sentry_dsn
